{
  "schemaVersion": 1,
  "id": "la.tessel.roboboy.webrtc",
  "name": "WebRTC / RTSP Camera",
  "description": "Plays low-latency WHEP streams and documents their RTSP gateway source.",
  "version": "3.0.0",
  "entryPoint": "./dist/index.js",
  "integrity": "sha256-e3HA/1myHwOCtwhV8IEKRtFYoo1FGSdeKYROObdpUFY=",
  "compatibility": {
    "panelApi": "^2.0.0",
    "roboboy": ">=0.6.0-0 <1.0.0"
  },
  "capabilities": [
    "network",
    "storage"
  ],
  "permissions": {
    "network": {
      "hostEndpoints": [
        "webrtcWhep",
        "webrtcDiscovery",
        "webrtcHls"
      ]
    }
  },
  "author": {
    "name": "Tessella"
  },
  "repository": "https://github.com/tessel-la/roboboy-webrtc-panel",
  "tags": [
    "camera",
    "webrtc",
    "whep",
    "rtsp",
    "video"
  ]
}
